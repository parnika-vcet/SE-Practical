<mxfile host="app.diagrams.net">
  <diagram name="Waterfall Model" id="waterfall">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Waterfall Model" style="text;html=1;fontStyle=1;fontSize=28;align=left;" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="280" height="50" as="geometry"/>
        </mxCell>

        <!-- Phases (staircase) -->
        <mxCell id="req" value="Requirement&lt;br&gt;Analysis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="design" value="Design" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="145" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="impl" value="Implementation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="210" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="test" value="Testing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="275" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="deploy" value="Deployment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="340" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="maint" value="Maintenance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="405" width="140" height="50" as="geometry"/>
        </mxCell>

        <!-- Curved arrows from each phase to the next -->
        <mxCell id="n1" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="req" target="design"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n2" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="design" target="impl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n3" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="impl" target="test"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n4" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="test" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="deploy" target="maint"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Vertical lines down to the baseline -->
        <mxCell id="v1" style="endArrow=none;html=1;strokeWidth=2;exitX=0.143;exitY=1;" edge="1" parent="1" source="req"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v2" style="endArrow=none;html=1;strokeWidth=2;exitX=0.143;exitY=1;" edge="1" parent="1" source="design"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v3" style="endArrow=none;html=1;strokeWidth=2;exitX=0.143;exitY=1;" edge="1" parent="1" source="impl"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v4" style="endArrow=none;html=1;strokeWidth=2;exitX=0.143;exitY=1;" edge="1" parent="1" source="test"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v5" style="endArrow=none;html=1;strokeWidth=2;exitX=0.143;exitY=1;" edge="1" parent="1" source="deploy"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="430" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Baseline arrow into Maintenance -->
        <mxCell id="base" style="endArrow=block;endFill=1;html=1;strokeWidth=2;entryX=0;entryY=0.5;" edge="1" parent="1" target="maint"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="430" as="sourcePoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
